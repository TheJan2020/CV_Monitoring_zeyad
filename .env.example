# =============================================================================
# Frigate — camera feed
# =============================================================================
FRIGATE_BASE_URL=http://192.168.100.42:5000
FRIGATE_CAMERA=workshop
FRIGATE_HTTP_FPS=2

# Terminal logging: 1 = every frame, all pipeline stages; 0 = compact
LOG_VERBOSE=1

# =============================================================================
# Pipeline: Pass 1 people | Pass 2 devices (one YOLO) | optional COCO tools
# =============================================================================
YOLO_MODEL=yolo11s.pt
YOLO_CONF=0.05
YOLO_PERSON_CONF=0.02
YOLO_IMGSZ=1280
YOLO_IOU=0.45
SHOW_ALL_TOOLS=1
USE_YOLO_PEOPLE_PASS=1
USE_YOLO_DEVICES_PASS=1

# =============================================================================
# Pass 1 — People (person boxes + pose)
# =============================================================================
USE_POSE=1
USE_YOLO_POSE=1
YOLO_POSE_MODEL=yolo11s-pose.pt
YOLO_POSE_CONF=0.25
POSE_MIN_DETECTION_CONF=0.3
POSE_CROP_PAD=0.25
WRIST_BOX_HALF_FRAC=0.022
HAND_BOX_FOREARM_SCALE=0.38
HAND_BOX_EXTEND_FRAC=0.22

# =============================================================================
# Pass 2 — Work devices (one YOLO run; toggle each class)
# =============================================================================
YOLO_PHONE_MODEL=yolo11m.pt
YOLO_DEVICES_CONF=
YOLO_DEVICES_IMGSZ=960
USE_YOLO_PHONE_PASS=1
USE_YOLO_LAPTOP_PASS=1
USE_YOLO_KEYBOARD_PASS=1
USE_YOLO_MOUSE_PASS=1

# Phone (67)
YOLO_PHONE_CONF=0.03
YOLO_PHONE_IMGSZ=960
USE_PHONE_HAND_CROP=1
PHONE_HAND_CROP_PAD=0.40
PHONE_MIN_CONF=0.25
PHONE_STABLE_SECONDS=3
PHONE_STABLE_MIN_CONF=0.5
WRIST_PHONE_MIN_IOU_PCT=8
WRIST_PHONE_MIN_WRIST_COV_PCT=12
WRIST_PHONE_MIN_PHONE_COV_PCT=15

# Laptop (63)
YOLO_LAPTOP_CONF=0.12
YOLO_LAPTOP_IMGSZ=960
LAPTOP_MIN_CONF=0.20
LAPTOP_STABLE_SECONDS=3
LAPTOP_STABLE_MIN_CONF=0.5
WRIST_LAPTOP_MIN_IOU_PCT=10
WRIST_LAPTOP_MIN_HAND_COV_PCT=15
WRIST_LAPTOP_MIN_LAPTOP_COV_PCT=12

# Keyboard (66)
YOLO_KEYBOARD_CONF=0.12
YOLO_KEYBOARD_IMGSZ=960
KEYBOARD_MIN_CONF=0.20
KEYBOARD_STABLE_SECONDS=3
KEYBOARD_STABLE_MIN_CONF=0.5
WRIST_KEYBOARD_MIN_IOU_PCT=10
WRIST_KEYBOARD_MIN_HAND_COV_PCT=15
WRIST_KEYBOARD_MIN_KEYBOARD_COV_PCT=12

# Mouse (64)
YOLO_MOUSE_CONF=0.12
YOLO_MOUSE_IMGSZ=960
MOUSE_MIN_CONF=0.20
MOUSE_STABLE_SECONDS=3
MOUSE_STABLE_MIN_CONF=0.5
WRIST_MOUSE_MIN_IOU_PCT=10
WRIST_MOUSE_MIN_HAND_COV_PCT=15
WRIST_MOUSE_MIN_MOUSE_COV_PCT=12

# =============================================================================
# Workbench zone & activity scoring
# =============================================================================
WORKBENCH_ROI=0,0,1,1
WORK_SECONDS=10
WORK_OFF_SECONDS=4
PRESENT_SECONDS=3
SCORE_MEDIUM=0.50
SCORE_STRICT=0.62
